{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "display_name": {
      "type": "string",
      "title": "\u8868\u793a\u540d"
    },
    "avatar_url": {
      "type": "string",
      "title": "\u30d7\u30ed\u30d5\u30a3\u30fc\u30eb\u753b\u50cf"
    },
    "bio": {
      "type": "string",
      "title": "\u81ea\u5df1\u7d39\u4ecb"
    },
    "country": {
      "type": "string",
      "title": "\u56fd(ISO\u30b3\u30fc\u30c9)"
    },
    "hobbies": {
      "type": "string",
      "title": "\u8da3\u5473(JSON\u914d\u5217)",
      "default": "[]"
    },
    "training_purpose": {
      "type": "string",
      "title": "\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u76ee\u7684"
    },
    "gender": {
      "type": "string",
      "title": "\u6027\u5225",
      "enum": [
        "male",
        "female",
        "undisclosed"
      ]
    },
    "gender_public": {
      "type": "boolean",
      "default": false,
      "title": "\u6027\u5225\u516c\u958b"
    },
    "languages": {
      "type": "string",
      "title": "\u8a71\u305b\u308b\u8a00\u8a9e(JSON\u914d\u5217)",
      "default": "[]"
    },
    "age": {
      "type": "number",
      "title": "\u5e74\u9f62"
    },
    "age_public": {
      "type": "boolean",
      "default": false,
      "title": "\u5e74\u9f62\u516c\u958b"
    },
    "lat": {
      "type": "number",
      "title": "\u7def\u5ea6"
    },
    "lng": {
      "type": "number",
      "title": "\u7d4c\u5ea6"
    },
    "share_location": {
      "type": "boolean",
      "default": true,
      "title": "\u4f4d\u7f6e\u60c5\u5831\u516c\u958b"
    },
    "show_online_status": {
      "type": "boolean",
      "default": true,
      "title": "\u30aa\u30f3\u30e9\u30a4\u30f3\u72b6\u614b\u8868\u793a"
    },
    "searchable_by_id": {
      "type": "boolean",
      "default": true,
      "title": "ID\u691c\u7d22\u8a31\u53ef"
    },
    "searchable_by": {
      "type": "string",
      "title": "\u691c\u7d22\u53ef\u80fd\u7bc4\u56f2",
      "enum": [
        "everyone",
        "followings",
        "none"
      ],
      "default": "everyone"
    },
    "timeline_visibility": {
      "type": "string",
      "title": "\u30bf\u30a4\u30e0\u30e9\u30a4\u30f3\u516c\u958b\u7bc4\u56f2",
      "enum": [
        "everyone",
        "followers",
        "private"
      ],
      "default": "everyone"
    },
    "timeline_gender_restriction": {
      "type": "string",
      "title": "\u30bf\u30a4\u30e0\u30e9\u30a4\u30f3\u6027\u5225\u5236\u9650",
      "enum": [
        "none",
        "female_only",
        "male_only"
      ],
      "default": "none"
    },
    "notif_prefs": {
      "type": "string",
      "title": "\u901a\u77e5\u8a2d\u5b9a(JSON)",
      "default": "{\"dm\":true,\"follow\":true,\"comment\":true}"
    },
    "dm_scope": {
      "type": "string",
      "title": "DM\u53d7\u4fe1\u7bc4\u56f2",
      "enum": [
        "everyone",
        "followings",
        "none"
      ],
      "default": "everyone"
    },
    "fitness_goal": {
      "type": "string",
      "title": "Fitness Goal"
    },
    "training_history": {
      "type": "string",
      "title": "\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u6b74"
    },
    "specialty": {
      "type": "string",
      "title": "\u5f97\u610f\u7a2e\u76ee"
    },
    "language": {
      "type": "string",
      "title": "\u8868\u793a\u8a00\u8a9e"
    }
  },
  "required": [
