{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "display_name": {
      "type": "string",
      "title": "\u8868\u793a\u540d"
    },
    "avatar_url": {
      "type": "string",
      "title": "\u30d7\u30ed\u30d5\u30a3\u30fc\u30eb\u753b\u50cf"
    },
    "bio": {
      "type": "string",
      "title": "\u81ea\u5df1\u7d39\u4ecb"
    },
    "country": {
      "type": "string",
      "title": "\u56fd(ISO\u30b3\u30fc\u30c9)"
    },
    "region": {
      "type": "string",
      "title": "\u5730\u57df/\u90fd\u5e9c\u770c"
    },
    "hobbies": {
      "type": "string",
      "title": "\u8da3\u5473(JSON\u914d\u5217)",
      "default": "[]"
    },
    "training_purpose": {
      "type": "string",
      "title": "\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u76ee\u7684"
    },
    "gender": {
      "type": "string",
      "title": "\u6027\u5225",
      "enum": [
        "male",
        "female",
        "undisclosed"
      ]
    },
    "gender_change_count": {
      "type": "number",
      "title": "\u6027\u5225\u5909\u66f4\u56de\u6570",
      "default": 0
    },
    "gender_public": {
      "type": "boolean",
      "default": false,
      "title": "\u6027\u5225\u516c\u958b"
    },
    "languages": {
      "type": "string",
      "title": "\u8a71\u305b\u308b\u8a00\u8a9e(JSON\u914d\u5217)",
      "default": "[]"
    },
    "main_language": {
      "type": "string",
      "title": "\u30e1\u30a4\u30f3\u8a00\u8a9e(\u8a00\u8a9e\u30eb\u30fc\u30e0\u7528)",
      "description": "\u521d\u671f\u8a2d\u5b9a\u3067\u30e6\u30fc\u30b6\u30fc\u304c\u9078\u3093\u3060\u8a00\u8a9e\u3002\u30a2\u30d7\u30ea\u8868\u793a\u8a00\u8a9e\u3068\u306f\u5225\u30c7\u30fc\u30bf\u3002"
    },
    "birthdate": {
      "type": "string",
      "format": "date",
      "title": "\u751f\u5e74\u6708\u65e5"
    },
    "birthdate_change_count": {
      "type": "number",
      "title": "\u751f\u5e74\u6708\u65e5\u5909\u66f4\u56de\u6570",
      "default": 0
    },
    "registered_birthdate": {
      "type": "string",
      "format": "date",
      "title": "\u767b\u9332\u6642\u751f\u5e74\u6708\u65e5",
      "description": "\u672a\u6210\u5e74/\u6210\u4eba\u533a\u5206\u5224\u5b9a\u7528\u306e\u521d\u671f\u767b\u9332\u6642\u751f\u5e74\u6708\u65e5"
    },
    "age": {
      "type": "number",
      "title": "\u5e74\u9f62"
    },
    "age_public": {
      "type": "boolean",
      "default": false,
      "title": "\u5e74\u9f62\u516c\u958b"
    },
    "level": {
      "type": "string",
      "title": "\u30ec\u30d9\u30eb",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "level_updated_at": {
      "type": "string",
      "format": "date-time",
      "title": "\u30ec\u30d9\u30eb\u5909\u66f4\u65e5\u6642"
    },
    "country_name": {
      "type": "string",
      "title": "\u56fd\u540d"
    },
    "share_country": {
      "type": "boolean",
      "default": true,
      "title": "\u56fd\u3092\u516c\u958b"
    },
    "show_online_status": {
      "type": "boolean",
      "default": true,
      "title": "\u30aa\u30f3\u30e9\u30a4\u30f3\u72b6\u614b\u8868\u793a"
    },
    "searchable_by_id": {
      "type": "boolean",
      "default": true,
      "title": "ID\u691c\u7d22\u8a31\u53ef"
    },
    "searchable_by": {
      "type": "string",
      "title": "\u691c\u7d22\u53ef\u80fd\u7bc4\u56f2",
      "enum": [
        "everyone",
        "followings",
        "none"
      ],
      "default": "everyone"
    },
    "timeline_visibility": {
      "type": "string",
      "title": "\u30bf\u30a4\u30e0\u30e9\u30a4\u30f3\u516c\u958b\u7bc4\u56f2",
      "enum": [
        "everyone",
        "followers",
        "private"
      ],
      "default": "everyone"
    },
    "timeline_gender_restriction": {
      "type": "string",
      "title": "\u30bf\u30a4\u30e0\u30e9\u30a4\u30f3\u6027\u5225\u5236\u9650",
      "enum": [
        "none",
        "female_only",
        "male_only"
      ],
      "default": "none"
    },
    "notif_prefs": {
      "type": "string",
      "title": "\u901a\u77e5\u8a2d\u5b9a(JSON)",
      "default": "{\"dm\":true,\"follow\":true,\"comment\":true}"
    },
    "dm_scope": {
      "type": "string",
      "title": "DM\u53d7\u4fe1\u7bc4\u56f2",
      "enum": [
        "everyone",
        "followings",
        "none"
      ],
      "default": "everyone"
    },
    "fitness_goal": {
      "type": "string",
      "title": "Fitness Goal"
    },
    "training_history": {
      "type": "string",
      "title": "\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u6b74"
    },
    "specialty": {
      "type": "string",
      "title": "\u5f97\u610f\u7a2e\u76ee"
    },
    "language": {
      "type": "string",
      "title": "\u8868\u793a\u8a00\u8a9e"
    },
    "last_image_upload_date": {
      "type": "string",
      "format": "date",
      "title": "\u76f4\u8fd1\u753b\u50cf\u6295\u7a3f\u65e5"
    },
    "login_days": {
      "type": "string",
      "title": "\u30ed\u30b0\u30a4\u30f3\u65e5(JSON\u914d\u5217)",
      "default": "[]"
    },
    "deletion_requested": {
      "type": "boolean",
      "default": false,
      "title": "\u30a2\u30ab\u30a6\u30f3\u30c8\u524a\u9664\u7533\u8acb\u6e08\u307f"
    },
    "deletion_requested_at": {
      "type": "string",
      "format": "date-time",
      "title": "\u524a\u9664\u7533\u8acb\u65e5\u6642"
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}